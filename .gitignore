# =============================================================================
# AR Based Dental Imaging and Abnormality Visualization
# Root .gitignore — covers Step 1 (project/, Python) and Steps 2-3
# (step2_mouth_ar/, Node/Vite). See README.md for setup.
# =============================================================================

# --- Python (Step 1: project/) ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/
env/
pip-wheel-metadata/

# --- Node / Vite (Steps 2-3: step2_mouth_ar/) -------------------------------
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# Self-signed HTTPS cert generated by serve_https.py for on-device testing.
# Machine-specific and regenerated automatically on first run — never commit.
step2_mouth_ar/.cert/

# Scratch output from the tools/*.py development scripts (diagnostic images
# written when iterating on the tooth-segmentation algorithm; not shipped).
step2_mouth_ar/tools/_diag_output/

# Vendored MediaPipe WASM runtime + face landmark model. These are large
# binaries that are either copied out of node_modules (`npm run vendor:wasm`)
# or downloaded from Google's model store (`npm run fetch:model`); both run
# automatically via `npm install` (see package.json "postinstall"). Keeping
# them out of git avoids storing a second copy of what npm/the model host
# already serve. See step2_mouth_ar/README.md "Quick start".
step2_mouth_ar/public/wasm/
step2_mouth_ar/public/ort/
step2_mouth_ar/public/models/*
# the trained tooth model is small and is a project artefact: commit it
!step2_mouth_ar/public/models/tooth_seg.onnx
!step2_mouth_ar/public/models/tooth_seg.json

# Capacitor native project output (generated by `npx cap add android/ios`)
step2_mouth_ar/android/
step2_mouth_ar/ios/

# --- Editor / OS junk --------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/

# Stray screenshots pasted into a chat session that land in this directory
# as a side effect (not project assets — e.g. a screenshot shown to an AI
# assistant while debugging). Never intended to be committed. (.gitignore
# patterns are not shell-parsed, so spaces here are literal — no quotes.)
Pasted image*.png
Pasted Graphic*.png
Screenshot*.png

# --- Secrets / local env -----------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# regenerable evaluation crops and training data
step2_mouth_ar/tests/eval/rois/
step2_mouth_ar/tools/train/_data/
